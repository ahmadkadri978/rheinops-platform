{
  "realm": "rheinops",
  "enabled": true,
  "displayName": "RheinOps Local Development",
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "loginWithEmailAllowed": false,
  "duplicateEmailsAllowed": false,
  "bruteForceProtected": true,
  "roles": {
    "realm": [
      {
        "name": "VIEWER",
        "description": "Read services, incidents, and incident timelines"
      },
      {
        "name": "RESPONDER",
        "description": "Report incidents and move them through the response lifecycle"
      },
      {
        "name": "INCIDENT_MANAGER",
        "description": "Manage the service catalog and incident response"
      },
      {
        "name": "ADMINISTRATOR",
        "description": "Administer RheinOps and access restricted operational endpoints"
      }
    ]
  },
  "clients": [
    {
      "clientId": "rheinops-cli",
      "name": "RheinOps Local CLI",
      "description": "Local demonstration client only; direct grants must not be enabled in production",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "protocolMappers": [
        {
          "name": "rheinops realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "rheinops api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "rheinops-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "rheinops-prometheus",
      "name": "RheinOps Local Prometheus",
      "description": "Local reliability-lab service account only; replace this disposable secret outside local Compose",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "prometheus-demo-only",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": true,
      "protocolMappers": [
        {
          "name": "rheinops realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "rheinops api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "rheinops-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "viewer",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "viewer-demo",
          "temporary": false
        }
      ],
      "realmRoles": ["VIEWER"]
    },
    {
      "username": "responder",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "responder-demo",
          "temporary": false
        }
      ],
      "realmRoles": ["RESPONDER"]
    },
    {
      "username": "incident-manager",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "manager-demo",
          "temporary": false
        }
      ],
      "realmRoles": ["INCIDENT_MANAGER"]
    },
    {
      "username": "administrator",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "administrator-demo",
          "temporary": false
        }
      ],
      "realmRoles": ["ADMINISTRATOR"]
    },
    {
      "username": "service-account-rheinops-prometheus",
      "enabled": true,
      "serviceAccountClientId": "rheinops-prometheus",
      "realmRoles": ["ADMINISTRATOR"]
    }
  ]
}
